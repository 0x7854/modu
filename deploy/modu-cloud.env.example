# 墨读云文档库生产环境示例。复制到 /etc/modu/cloud.env，root:modu 0640。
# 这里没有任何密码或同步令牌；账户由 cloud/manage.js 交互创建。
MODU_CLOUD_HOST=127.0.0.1
MODU_CLOUD_PORT=4680
MODU_CLOUD_DATA=/var/lib/modu
MODU_PUBLIC_ORIGIN=https://md.example.com
MODU_TRUST_PROXY=1
MODU_COOKIE_SECURE=auto
MODU_SESSION_TTL_HOURS=168
MODU_LOGIN_MAX_ATTEMPTS=5
MODU_LOGIN_WINDOW_MINUTES=15
MODU_MAX_DOC_BYTES=2097152
MODU_POLL_MS=5000

# MODU_DEBUG=1
