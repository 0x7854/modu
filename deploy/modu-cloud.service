[Unit]
Description=Modu private Markdown library
After=network.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=modu
Group=modu
WorkingDirectory=/opt/modu/current
ExecStart=/opt/modu-node/bin/node cloud/server.js
EnvironmentFile=/etc/modu/cloud.env
Environment=NODE_OPTIONS=--max-old-space-size=128
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/modu
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryHigh=192M
MemoryMax=256M
CPUQuota=50%
Nice=10
TasksMax=64
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
