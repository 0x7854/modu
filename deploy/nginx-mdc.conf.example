# 墨读云文档库反向代理示例。
# 将证书路径替换为 certbot 实际生成的文件；私钥不要提交到仓库。
# Node 只监听 127.0.0.1:4680，公网只开 80/443。

server {
    listen 80;
    listen [::]:80;
    server_name md.example.com;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name md.example.com;

    ssl_certificate     /etc/letsencrypt/live/md.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/md.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # 为导入 JSON 的转义预留空间；Node 仍按各接口校验正文上限。
    client_max_body_size 16m;
    client_body_timeout 20s;
    proxy_read_timeout 60s;
    proxy_send_timeout 60s;

    location / {
        proxy_pass http://127.0.0.1:4680;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location = /healthz {
        proxy_pass http://127.0.0.1:4680;
        proxy_set_header Host $host;
        access_log off;
    }
}
